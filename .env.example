# Copy this file to .env for local development.
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/college_events
# true      = TLS with certificate verification (use this for Neon and other managed providers)
# no-verify = encrypted, certificate NOT verified (last resort)
# false     = no TLS (local development)
# Note: an sslmode=... inside DATABASE_URL overrides this setting.
PGSSL=false
# Replace with a long random secret. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@college.example
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Email notifications. Leave SMTP_HOST empty to queue emails without delivering them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusConnect <no-reply@example.com>
EVENT_TIMEZONE=Asia/Kolkata
